# Copy to .env and adjust: cp .env.example .env
# Values below are placeholders for the local Docker stand only

# PostgreSQL (docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fastapi_db

# App
DATABASE_URL=postgresql://postgres:postgres@db:5432/fastapi_db
SECRET_KEY=change-me-local-only
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate limits (defaults; raise to 1000/minute for functional testing, see docs/checklists)
DEFAULT_RATE_LIMIT=100/minute
LOGIN_RATE_LIMIT=5/minute
REGISTER_RATE_LIMIT=3/minute
ITEMS_READ_RATE_LIMIT=60/minute
ITEMS_WRITE_RATE_LIMIT=30/minute
